# Wave E 中间件（本地 Docker + IDE 开发）
# 复制为 .env 仅当你用 compose env_file 或脚本注入时使用；勿提交含真实密码的 .env
# 详见 docs/deploy.md §5.1

# --- Redis（E-B1 限流 / E-B2 缓存）---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- RabbitMQ（E-B3 异步任务）---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=workbench
RABBITMQ_PASSWORD=workbench
RABBITMQ_VHOST=/