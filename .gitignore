# =========================
# IDE / 编辑器
# =========================
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
.cursor/

# =========================
# 操作系统
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# 环境变量 / 本地密钥（勿提交）
# =========================
.env
.env.*
!.env.example
*.local

# Spring Boot 本地配置（数据库密码、JWT secret 等放这里）
**/application-local.yml
**/application-local.properties
**/application-local.yaml

# =========================
# Node / 前端
# =========================
node_modules/
dist/
dist-ssr/

# =========================
# Python
# =========================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# =========================
# Java / Maven
# =========================
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven wrapper jar 由 wrapper 脚本自动下载，不必入库
**/.mvn/wrapper/maven-wrapper.jar

# =========================
# 日志与临时文件
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# 上传文件 / 本地存储（业务运行时产生）
# =========================
uploads/
storage/
